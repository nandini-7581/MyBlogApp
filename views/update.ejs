<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update a Post</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="update-page">
    <main class="container py-4 py-md-5">
        <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-5 border-bottom">
            <a href="/" class="blog-header-logo text-body-emphasis text-decoration-none">Nandini's Blog</a>
            <nav class="d-flex gap-2" aria-label="Post navigation">
                <a href="/viewposts" class="btn btn-outline-secondary">View posts</a>
                <a href="/newpost" class="btn btn-primary">New post</a>
            </nav>
        </header>

        <section class="update-panel mx-auto">
            <div class="mb-4">
                <p class="text-uppercase text-primary fw-semibold small mb-2">Manage your writing</p>
                <h1 class="display-6 fw-bold mb-2">Update a post</h1>
                <p class="text-body-secondary mb-0">Choose a post below to revise its title or content.</p>
            </div>

            <% if (posts.length === 0) { %>
                <div class="alert alert-info mb-0">There are no posts available to update.</div>
            <% } else { %>
                <form action="/update_selected" method="GET" class="update-form">
                    <div class="mb-4">
                        <label for="postId" class="form-label fw-semibold">Post to update</label>
                        <select id="postId" name="postId" class="form-select form-select-lg" required>
                            <% posts.forEach((post) => { %>
                                <option value="<%= post.id %>"><%= post.title %></option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg">Continue to editor</button>
                </form>
            <% } %>
        </section>
    </main>

    <footer class="py-4 text-center text-body-secondary border-top mt-5">
        <p class="mb-0">Nandini's Blog &copy; 2026</p>
    </footer>
</body>
</html>