<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <main class="container py-4">
        <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
            <a href="/" class="text-body-emphasis text-decoration-none">
                <span class="fs-4 fw-bold">My Blog</span>
            </a>
            <a href="/newpost" class="btn btn-primary">New post</a>
        </header>

        <div class="p-5 mb-4 bg-body-tertiary rounded-3">
            <h1 class="display-5 fw-bold">All posts</h1>
            <p class="lead mb-0">Browse all the latest stories and ideas.</p>
        </div>

        <% if (posts.length === 0) { %>
            <div class="alert alert-info">There are no posts yet.</div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <% posts.forEach((post) => { %>
                    <div class="col">
                        <article class="card h-100 shadow-sm">
                            <img
                                src="<%= post.image || '/images/featured-post.svg' %>"
                                class="card-img-top"
                                alt="Image for <%= post.title %>"
                                style="height: 220px; object-fit: cover;"
                            >
                            <div class="card-body d-flex flex-column">
                                <h2 class="card-title h4"><%= post.title %></h2>
                                <p class="card-text"><%= post.content %></p>
                                <a href="#" class="btn btn-outline-primary mt-auto">Read more</a>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <footer class="pt-3 mt-4 text-body-secondary border-top">© 2026</footer>
    </main>
</body>
</html>
