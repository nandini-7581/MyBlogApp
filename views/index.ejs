<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nandini's Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <header class="border-bottom lh-1 py-3">
            <div class="row flex-nowrap justify-content-between align-items-center">
                <div class="col-4 pt-1"><a class="link-secondary" href="#">Subscribe</a></div>
                <div class="col-4 text-center"><a class="blog-header-logo text-body-emphasis text-decoration-none" href="/">Nandini's Blog</a></div>
                <div class="col-4 d-flex justify-content-end align-items-center"><a class="btn btn-sm btn-outline-secondary" href="/newpost">New post</a></div>
            </div>
        </header>
        <div class="nav-scroller py-1 mb-3 border-bottom">
            <nav class="nav nav-underline justify-content-between">
                <a class="nav-item nav-link link-body-emphasis active" href="/viewposts">View All Posts</a>
                <a class="nav-item nav-link link-body-emphasis" href="/newpost">New Post</a>
                <a class="nav-item nav-link link-body-emphasis" href="/update">Update Post</a>
                <a class="nav-item nav-link link-body-emphasis" href="/delete">Delete a Post</a>
            </nav>
        </div>
    </div>

    <main class="container">
        <section class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary">
            <div class="col-lg-8 px-0">
                <h1 class="display-4 fst-italic">Ideas worth sharing</h1>
                <p class="lead my-3">This blog is a space for thoughtful stories, creative experiments, and useful lessons from the things I am learning and exploring.</p>
                <p class="lead mb-0"><a href="/viewposts" class="text-body-emphasis fw-bold">Explore all posts</a></p>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="pb-4 mb-4 fst-italic border-bottom">Featured posts</h2>
            <div class="row g-4">
                <% posts.slice(0, 2).forEach((post) => { %>
                    <div class="col-md-6">
                        <article class="card h-100 shadow-sm overflow-hidden">
                            <img src="<%= post.image || '/images/featured-post.svg' %>" class="card-img-top" alt="Image for <%= post.title %>" style="height: 220px; object-fit: cover;">
                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title"><%= post.title %></h3>
                                <p class="card-text"><%= post.content %></p>
                                <a href="/viewposts" class="btn btn-outline-primary mt-auto align-self-start">View all posts</a>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>
        </section>

        <section class="row g-5">
            <div class="col-md-8">
                <h2 class="pb-4 mb-4 fst-italic border-bottom">Why this blog exists</h2>
                <p>Good ideas become more useful when they are written down and shared. This blog brings together personal reflections, practical projects, and creative discoveries in one place.</p>
                <p>Whether you are here for inspiration, a new perspective, or a small idea to try, I hope each post gives you something worth carrying forward.</p>
            </div>
            <aside class="col-md-4">
                <div class="p-4 bg-body-tertiary rounded">
                    <h3 class="fst-italic">Start exploring</h3>
                    <p class="mb-0">Browse the complete collection to discover the latest stories and ideas.</p>
                    <a class="btn btn-primary mt-3" href="/viewposts">View all posts</a>
                </div>
            </aside>
        </section>
    </main>

    <footer class="py-5 text-center text-body-secondary bg-body-tertiary mt-5">
        <p class="mb-0">Nandini's Blog &copy; 2026</p>
    </footer>
</body>
</html>